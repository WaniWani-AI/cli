{
  "name": "@waniwani/cli",
  "version": "0.1.14",
  "description": "WaniWani CLI for MCP development workflow",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "waniwani": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run typecheck && bun run lint && tsup",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "prepublishOnly": "bun run build",
    "release": "npm run release:patch",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "release:beta": "npm version prerelease --preid beta && git push --follow-tags",
    "release:alpha": "npm version prerelease --preid alpha && git push --follow-tags"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "cloudflared": "^0.7.1",
    "commander": "^14.0.2",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "ignore": "^7.0.5",
    "ora": "^9.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/degit": "^2.8.6",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaniWani-AI/cli.git"
  },
  "keywords": [
    "cli",
    "mcp",
    "waniwani",
    "vercel",
    "sandbox",
    "claude",
    "node",
    "npm",
    "pnpm",
    "yarn"
  ],
  "author": "WaniWani",
  "license": "MIT"
}
